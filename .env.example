# Google OAuth: paste your Google Cloud Console "Web client" ID here
# (same value as GOOGLE_CLIENT_ID on the server). Copy .env.example to .env
# and replace this with your real value.
VITE_GOOGLE_CLIENT_ID=replace-with-your-google-client-id
# Local development: keep http://localhost:5000/api
# For Vercel (production): set VITE_API_URL in Vercel project env vars to the deployed
# backend URL, e.g. https://student-hub-api.onrender.com/api
# WITHOUT it, the deployed site cannot reach the API (SPA rewrite returns HTML).
VITE_API_URL=http://localhost:5000/api

